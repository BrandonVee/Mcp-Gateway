# Copy to app.env, fill in deployment values, and chmod 600 the copy.
# Commands below use --env-file deploy/app.env from the repository root.
COMPOSE_PROJECT_NAME=mcp-app
MCP_VERSION=replace-with-release-or-commit
# Empty for builds on this server; e.g. ghcr.io/your-lowercase-account/ for pulls.
# Include the trailing slash when set.
MCP_IMAGE_PREFIX=
# For Docker Hub: MCP_IMAGE_PREFIX=brandonvee/ and MCP_IMAGE_NAME=mcp-gateway.
MCP_IMAGE_NAME=mcp-app

# These hosts must be reachable from the containers; localhost is the container.
# Percent-encode special characters in URL usernames/passwords.
DATABASE_URL=postgres://mcp:replace-with-database-password@db.internal.example:5432/mcp
REDIS_URL=redis://:replace-with-redis-password@redis.internal.example:6379/0

# Generate three separate values with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-with-independent-random-token
CREDENTIAL_BROKER_TOKEN=replace-with-another-independent-random-token
CREDENTIAL_ENCRYPT_KEY=replace-with-64-hex-characters

MCP_HTTP_PORT=8080
ADMIN_USERNAME=admin
# At least 16 characters; needed only when the first administrator is created.
ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Public URL, upstream allowlist and registration are configured in System settings.
# Additional browser MCP client origins; non-browser clients may omit Origin.
MCP_ALLOWED_ORIGINS=https://admin.example.com
UPSTREAM_MAX_ACTIVE_REQUESTS=100

# Fill with the actual trusted proxy addresses; see docs/production.md.
AUTH_TRUSTED_PROXY_IPS=
