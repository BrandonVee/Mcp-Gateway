{
  "name": "mcp-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "dev:detached": "docker compose up -d --build",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:admin": "pnpm --filter @mcp/admin-web dev",
    "build:admin": "pnpm --filter @mcp/admin-web build",
    "dev:auth": "pnpm --filter @mcp/auth-server dev",
    "dev:gateway": "pnpm --filter @mcp/gateway dev",
    "dev:mcp": "pnpm --filter @mcp/mcp-server dev",
    "typecheck": "pnpm -r typecheck",
    "smoke": "tsx scripts/smoke.ts",
    "client": "tsx scripts/client-demo.ts",
    "token": "tsx scripts/get-token.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@modelcontextprotocol/sdk": "^1.12.0"
  }
}
