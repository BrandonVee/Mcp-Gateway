{
  "name": "mcp-gateway",
  "version": "0.5.3",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "dev:detached": "docker compose up -d --build",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:admin": "pnpm --filter @mcp/admin-web dev",
    "build:admin": "pnpm --filter @mcp/admin-web build",
    "build:runtime": "node scripts/build-runtime.mjs",
    "dev:auth": "pnpm --filter @mcp/auth-server dev",
    "dev:gateway": "pnpm --filter @mcp/gateway dev",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test scripts/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "client": "tsx scripts/client.ts",
    "token": "tsx scripts/get-token.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
