FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS builder
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY scripts/build-runtime.mjs ./scripts/build-runtime.mjs
COPY tests ./tests
COPY config ./config
RUN pnpm install --frozen-lockfile
RUN pnpm build:runtime && pnpm build:admin

# Smoke-test upstreams are isolated from the production runtime target.
FROM builder AS test-upstream
CMD ["pnpm", "--filter", "@mcp/test-upstream", "start"]

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runtime
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/auth-server/package.json ./packages/auth-server/package.json
COPY packages/gateway/package.json ./packages/gateway/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/auth-server/drizzle ./packages/auth-server/drizzle
RUN pnpm install --prod --frozen-lockfile --filter @mcp/auth-server --filter @mcp/gateway
COPY --from=builder /app/packages/auth-server/dist ./packages/auth-server/dist
COPY --from=builder /app/packages/gateway/dist ./packages/gateway/dist
USER node

FROM nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94 AS admin-web
COPY deploy/nginx-main.conf /etc/nginx/nginx.conf
COPY deploy/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/packages/admin-web/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
ENTRYPOINT ["nginx", "-g", "daemon off;"]

# Default production image: one application container, external PostgreSQL/Redis.
FROM runtime AS app
USER root
RUN apk add --no-cache nginx tini && mkdir -p /app/data && chown node:node /app/data && chmod 700 /app/data
COPY --from=builder /app/packages/admin-web/dist /usr/share/nginx/html
COPY deploy/nginx-app-main.conf /app/deploy/nginx-main.conf
COPY deploy/nginx-app.conf /app/deploy/nginx-app.conf
COPY deploy/app.json /app/config/app.json
COPY scripts/start-app.mjs scripts/setup-server.mjs scripts/update-container.mjs /app/scripts/
COPY scripts/setup /app/scripts/setup
USER node
ENV NODE_ENV=production SYSTEM_CONFIG_MODE=database CONFIG_FILE=/app/config/app.json
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=4s --start-period=120s --retries=12 CMD ["node", "-e", "fetch('http://127.0.0.1:8080/healthz',{signal:AbortSignal.timeout(3000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
ENTRYPOINT ["/sbin/tini", "--", "node", "/app/scripts/start-app.mjs"]
CMD []
