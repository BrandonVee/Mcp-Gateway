# Local host development (`pnpm dev:local`). Copy to .env.local if overrides are needed.
# `pnpm dev:local` generates CREDENTIAL_ENCRYPT_KEY and CREDENTIAL_BROKER_TOKEN
# in .env.local on first run; keep those generated values when reusing the database.

DATABASE_URL=postgres://mcp:mcp-dev-password@localhost:5432/mcp
REDIS_URL=redis://localhost:6379

# To use only PostgreSQL and Redis from Docker Compose instead, change to:
# DATABASE_URL=postgres://mcp:mcp-dev-password@127.0.0.1:5433/mcp
# REDIS_URL=redis://127.0.0.1:6380

# Optional: the default is config/default.json.
# CONFIG_FILE=config/default.json
