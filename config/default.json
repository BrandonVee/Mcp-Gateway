{
  "auth": {
    "port": 9001,
    "issuer": "http://localhost:9001",
    "accessTokenTtlSeconds": 3600,
    "defaultAudience": "mcp-gateway",
    "internalApiToken": "local-registry-token",
    "postgres": {
      "url": "postgres://mcp:mcp-dev-password@localhost:5432/mcp",
      "poolMax": 10
    },
    "bootstrap": {
      "adminUsername": "admin",
      "adminPassword": "admin123"
    }
  },
  "gateway": {
    "port": 8000,
    "resourceBaseUrl": "http://localhost:8000",
    "redisUrl": "redis://localhost:6379",
    "authJwksUrl": "http://localhost:9001/jwks.json",
    "jwtAudience": "mcp-gateway",
    "sessionTtlSeconds": 3600,
    "registryUrl": "http://localhost:9001/internal/mcp-servers",
    "registryRefreshSeconds": 15
  }
}
